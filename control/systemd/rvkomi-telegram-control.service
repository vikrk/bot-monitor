[Unit]
Description=Owner-only Telegram server control
After=network-online.target nginx.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/lib/rvkomi-watchdog
ExecStart=/usr/local/lib/rvkomi-watchdog/telegram-control.py poll
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
UMask=0077
StateDirectory=rvkomi-watchdog
StateDirectoryMode=0700
RuntimeDirectory=rvkomi-telegram-control rvkomi-watchdog
RuntimeDirectoryMode=0700
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/rvkomi-watchdog /run/rvkomi-telegram-control /run/rvkomi-watchdog /var/log/nginx

[Install]
WantedBy=multi-user.target

