[Unit]
Description=Read-only monitoring of configured fleet nodes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/rvkomi-watchdog/extra-monitor.py
TimeoutStartSec=1800
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
StateDirectory=rvkomi-watchdog
StateDirectoryMode=0700
ReadWritePaths=/var/lib/rvkomi-watchdog

