[Unit]
Description=Encrypted configuration backups to owner WebDAV router
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/rvkomi-watchdog
ExecStart=/usr/local/lib/rvkomi-watchdog/advanced.py backup
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=rvkomi-watchdog
ReadWritePaths=/var/lib/rvkomi-watchdog

