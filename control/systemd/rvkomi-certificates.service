[Unit]
Description=Daily local TLS certificate expiry warnings
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/rvkomi-watchdog
ExecStart=/usr/local/lib/rvkomi-watchdog/advanced.py certificates
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=rvkomi-watchdog
ReadWritePaths=/var/lib/rvkomi-watchdog

